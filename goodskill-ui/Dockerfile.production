FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_APP_MODE=production
ENV VITE_APP_MODE=${VITE_APP_MODE}
RUN npm run build

FROM nginx:1.27-alpine
ENV GOODSKILL_GATEWAY_UPSTREAM=http://gateway:8080
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.production.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 8080
CMD ["/bin/sh", "-c", "envsubst '${GOODSKILL_GATEWAY_UPSTREAM}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
