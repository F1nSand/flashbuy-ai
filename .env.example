# DeepSeek API Key（只传入 goodskill-ai 后端，不会进入前端包）
DEEPSEEK_API_KEY=

# DeepSeek OpenAI 兼容 API 地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 聊天模型：按供应商当前可用型号调整
DEEPSEEK_MODEL=deepseek-flash

# Production-only RabbitMQ settings. Keep credentials in a local secret store.
GOODSKILL_RABBITMQ_HOST=
GOODSKILL_RABBITMQ_PORT=5672
GOODSKILL_RABBITMQ_USERNAME=
GOODSKILL_RABBITMQ_PASSWORD=
GOODSKILL_RABBITMQ_VHOST=/

# Production-only Redis connection for gateway order rate limiting.
GOODSKILL_REDIS_HOST=
GOODSKILL_REDIS_PORT=6379
GOODSKILL_REDIS_PASSWORD=
GOODSKILL_REDIS_DATABASE=0
GOODSKILL_WEB_ALLOWED_ORIGINS=
GOODSKILL_GATEWAY_ORDER_RATE_PER_SECOND=2
GOODSKILL_GATEWAY_ORDER_RATE_BURST=10

# Production-only product image storage. Keep disabled until private HTTPS
# object storage, credentials and bucket provisioning have been verified.
GOODSKILL_FILES_ENABLED=false
GOODSKILL_MINIO_ENDPOINT=
GOODSKILL_MINIO_ACCESS_KEY=
GOODSKILL_MINIO_SECRET_KEY=
GOODSKILL_MINIO_BUCKET=
GOODSKILL_FILES_MAX_FILE_BYTES=5242880
GOODSKILL_FILES_MAX_PIXELS=12000000
GOODSKILL_FILES_OWNER_QUOTA_BYTES=52428800
GOODSKILL_FILES_CLEANUP_DELAY_MS=3600000
GOODSKILL_FILES_CLEANUP_INITIAL_DELAY_MS=60000

# Production-only order admission remains closed until capacity and release checks pass.
GOODSKILL_TRADE_ADMISSION_ENABLED=false

# Production-only Alipay V2 certificate mode. Payment stays disabled until all
# merchant values are supplied by a secret store and a verified HTTPS endpoint.
GOODSKILL_PAYMENT_ENABLED=false
GOODSKILL_PAYMENT_APP_ID=
GOODSKILL_PAYMENT_SELLER_ID=
GOODSKILL_PAYMENT_PRIVATE_KEY=
GOODSKILL_PAYMENT_APP_CERTIFICATE=
GOODSKILL_PAYMENT_ALIPAY_CERTIFICATE=
GOODSKILL_PAYMENT_ROOT_CERTIFICATE=
GOODSKILL_PAYMENT_GATEWAY=https://openapi.alipay.com/gateway.do
GOODSKILL_PAYMENT_NOTIFY_URL=
GOODSKILL_PAYMENT_RETURN_URL=
GOODSKILL_PAYMENT_CHECKOUT_MODE=page
